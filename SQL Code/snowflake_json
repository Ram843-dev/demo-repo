/* =====================================================================
   PART 9 : TASKS  (automation)
   TASK 1 (root)  : runs on schedule, COPY INTO loads new stage files into RAW
   TASK 2 (child) : runs after TASK 1, only if the stream has data,
                    calls the stored procedure
   Schedule = every day 1:00 AM India time.
   ===================================================================== */
CREATE OR REPLACE TASK ECOMMERCE_DATABASE.DW_SCHEMA.TASK_LOAD_RAW
    WAREHOUSE = COMPUTE_WH
    SCHEDULE  = 'USING CRON 0 1 * * * Asia/Kolkata'
AS
COPY INTO ECOMMERCE_DATABASE.RAW_SCHEMA.RAW_ECOMMERCE_ORDERS (VARIANT_COL, FILE_NAME, LOAD_TS)
FROM (
    SELECT $1, METADATA$FILENAME, CURRENT_TIMESTAMP()
    FROM @ECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_STAGE
)
FILE_FORMAT = (FORMAT_NAME = 'ECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_JSON_FORMAT')
ON_ERROR = 'SKIP_FILE';
 
CREATE OR REPLACE TASK ECOMMERCE_DATABASE.DW_SCHEMA.TASK_PROCESS_DW
    WAREHOUSE = COMPUTE_WH
    AFTER ECOMMERCE_DATABASE.DW_SCHEMA.TASK_LOAD_RAW
    WHEN SYSTEM$STREAM_HAS_DATA('ECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_ORDER_STREAM')
AS
CALL ECOMMERCE_DATABASE.DW_SCHEMA.PROCESS_ECOMMERCE_DATA();
 
-- Tasks are created SUSPENDED. Resume the child FIRST, then the root.
ALTER TASK ECOMMERCE_DATABASE.DW_SCHEMA.TASK_PROCESS_DW RESUME;
ALTER TASK ECOMMERCE_DATABASE.DW_SCHEMA.TASK_LOAD_RAW   RESUME;
 
