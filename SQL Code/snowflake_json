/* =====================================================================
   PART 6 : STREAM ON RAW TABLE
   SHOW_INITIAL_ROWS = TRUE means rows ALREADY in RAW are also treated as
   "new" the first time the procedure runs. So the same procedure does
   both the initial historical load and every later incremental load.
   ===================================================================== */
CREATE TABLE IF NOT EXISTS ECOMMERCE_DATABASE.RAW_SCHEMA.RAW_ECOMMERCE_ORDERS
(
    VARIANT_COL VARIANT,
    FILE_NAME   STRING,
    LOAD_TS     TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);
 

 USE ROLE SYSADMIN;
USE WAREHOUSE COMPUTE_WH;

CREATE STREAM IF NOT EXISTS ECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_ORDER_STREAM
    ON TABLE ECOMMERCE_DATABASE.RAW_SCHEMA.RAW_ECOMMERCE_ORDERS
    APPEND_ONLY = TRUE
    SHOW_INITIAL_ROWS = TRUE;
 
SHOW STREAMS IN SCHEMA ECOMMERCE_DATABASE.RAW_SCHEMA;
SELECT SYSTEM$STREAM_HAS_DATA('ECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_ORDER_STREAM');

CALL ECOMMERCE_DATABASE.DW_SCHEMA.PROCESS_ECOMMERCE_DATA();
/* =====================================================================
   PART 7 : STORED PROCEDURE  (the transformation engine)
   Steps inside:
     1. Copy new rows from the stream into STG_ORDER_LINES (flattened).
        (Done first, once, so every later step sees the same data.)
     2. MERGE DIM_CUSTOMER, DIM_PRODUCT, DIM_PAYMENT, DIM_DATE
     3. MERGE FACT_ORDERS (insert only lines that do not exist yet)
     4. COMMIT and write a log row. Any error -> ROLLBACK and log.
   ===================================================================== */
CREATE OR REPLACE PROCEDURE ECOMMERCE_DATABASE.DW_SCHEMA.PROCESS_ECOMMERCE_DATA()
RETURNS STRING
LANGUAGE SQL
EXECUTE AS OWNER
AS
$$
DECLARE
    v_staged NUMBER DEFAULT 0;
    v_fact   NUMBER DEFAULT 0;
BEGIN
 
    BEGIN TRANSACTION;
 
    -- ---------------------------------------------------------------
    -- STEP 1 : flatten new RAW rows into the staging table
    -- ---------------------------------------------------------------
    DELETE FROM ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES;
 
    INSERT INTO ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES
    (
        SALES_LINE_ID, ORDER_ID, ORDER_DATE, CUSTOMER_ID, CUSTOMER_NAME, CITY, STATE,
        PAYMENT_METHOD, PAYMENT_STATUS, ITEM_INDEX, PRODUCT_ID, PRODUCT_NAME, CATEGORY,
        QUANTITY, UNIT_PRICE, UNIT_COST, FILE_NAME, LOAD_TS
    )
    SELECT
        R.VARIANT_COL:order_id::STRING || '-' || F.INDEX::STRING           AS SALES_LINE_ID,
        R.VARIANT_COL:order_id::STRING                                      AS ORDER_ID,
        TRY_TO_DATE(R.VARIANT_COL:order_date::STRING)                       AS ORDER_DATE,
        R.VARIANT_COL:customer.customer_id::STRING                          AS CUSTOMER_ID,
        R.VARIANT_COL:customer.customer_name::STRING                        AS CUSTOMER_NAME,
        R.VARIANT_COL:customer.city::STRING                                 AS CITY,
        R.VARIANT_COL:customer.state::STRING                                AS STATE,
        COALESCE(R.VARIANT_COL:payment.payment_method::STRING, 'UNKNOWN')   AS PAYMENT_METHOD,
        COALESCE(R.VARIANT_COL:payment.payment_status::STRING, 'UNKNOWN')   AS PAYMENT_STATUS,
        F.INDEX                                                             AS ITEM_INDEX,
        F.VALUE:product_id::STRING                                          AS PRODUCT_ID,
        F.VALUE:product_name::STRING                                        AS PRODUCT_NAME,
        F.VALUE:category::STRING                                            AS CATEGORY,
        F.VALUE:quantity::NUMBER                                            AS QUANTITY,
        F.VALUE:unit_price::NUMBER(10,2)                                    AS UNIT_PRICE,
        F.VALUE:unit_cost::NUMBER(10,2)                                     AS UNIT_COST,
        R.FILE_NAME,
        R.LOAD_TS
    FROM ECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_ORDER_STREAM R,
         LATERAL FLATTEN(INPUT => R.VARIANT_COL:items) F
    WHERE R.VARIANT_COL:order_id IS NOT NULL
    -- if the same order arrives twice in one batch, keep the latest copy
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY R.VARIANT_COL:order_id::STRING, F.INDEX
                ORDER BY R.LOAD_TS DESC
            ) = 1;
 
    v_staged := SQLROWCOUNT;
 
    IF (v_staged = 0) THEN
        COMMIT;
        INSERT INTO ECOMMERCE_DATABASE.DW_SCHEMA.ETL_RUN_LOG (STATUS, ROWS_STAGED, ROWS_FACT, MESSAGE)
        VALUES ('NO_DATA', 0, 0, 'No new rows in stream');
        RETURN 'NO_DATA: no new rows in stream';
    END IF;
 
    -- ---------------------------------------------------------------
    -- STEP 2a : DIM_CUSTOMER  (new customers inserted, changed ones updated)
    -- ---------------------------------------------------------------
    MERGE INTO ECOMMERCE_DATABASE.DW_SCHEMA.DIM_CUSTOMER T
    USING
    (
        SELECT CUSTOMER_ID, CUSTOMER_NAME, CITY, STATE
        FROM ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES
        WHERE CUSTOMER_ID IS NOT NULL
        QUALIFY ROW_NUMBER() OVER (PARTITION BY CUSTOMER_ID ORDER BY ORDER_DATE DESC, LOAD_TS DESC) = 1
    ) S
    ON T.CUSTOMER_ID = S.CUSTOMER_ID
    WHEN MATCHED AND (   NOT EQUAL_NULL(T.CUSTOMER_NAME, S.CUSTOMER_NAME)
                      OR NOT EQUAL_NULL(T.CITY, S.CITY)
                      OR NOT EQUAL_NULL(T.STATE, S.STATE)) THEN
        UPDATE SET T.CUSTOMER_NAME = S.CUSTOMER_NAME,
                   T.CITY          = S.CITY,
                   T.STATE         = S.STATE,
                   T.UPDATED_TS    = CURRENT_TIMESTAMP()
    WHEN NOT MATCHED THEN
        INSERT (CUSTOMER_ID, CUSTOMER_NAME, CITY, STATE)
        VALUES (S.CUSTOMER_ID, S.CUSTOMER_NAME, S.CITY, S.STATE);
 
    -- ---------------------------------------------------------------
    -- STEP 2b : DIM_PRODUCT
    -- ---------------------------------------------------------------
    MERGE INTO ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PRODUCT T
    USING
    (
        SELECT PRODUCT_ID, PRODUCT_NAME, CATEGORY
        FROM ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES
        WHERE PRODUCT_ID IS NOT NULL
        QUALIFY ROW_NUMBER() OVER (PARTITION BY PRODUCT_ID ORDER BY ORDER_DATE DESC, LOAD_TS DESC) = 1
    ) S
    ON T.PRODUCT_ID = S.PRODUCT_ID
    WHEN MATCHED AND (   NOT EQUAL_NULL(T.PRODUCT_NAME, S.PRODUCT_NAME)
                      OR NOT EQUAL_NULL(T.CATEGORY, S.CATEGORY)) THEN
        UPDATE SET T.PRODUCT_NAME = S.PRODUCT_NAME,
                   T.CATEGORY     = S.CATEGORY,
                   T.UPDATED_TS   = CURRENT_TIMESTAMP()
    WHEN NOT MATCHED THEN
        INSERT (PRODUCT_ID, PRODUCT_NAME, CATEGORY)
        VALUES (S.PRODUCT_ID, S.PRODUCT_NAME, S.CATEGORY);
 
    -- ---------------------------------------------------------------
    -- STEP 2c : DIM_PAYMENT  (unique METHOD + STATUS combination)
    -- ---------------------------------------------------------------
    MERGE INTO ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PAYMENT T
    USING
    (
        SELECT DISTINCT PAYMENT_METHOD, PAYMENT_STATUS
        FROM ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES
    ) S
    ON  T.PAYMENT_METHOD = S.PAYMENT_METHOD
    AND T.PAYMENT_STATUS = S.PAYMENT_STATUS
    WHEN NOT MATCHED THEN
        INSERT (PAYMENT_METHOD, PAYMENT_STATUS)
        VALUES (S.PAYMENT_METHOD, S.PAYMENT_STATUS);
 
    -- ---------------------------------------------------------------
    -- STEP 2d : DIM_DATE  (adds any order date missing from the calendar)
    -- ---------------------------------------------------------------
    MERGE INTO ECOMMERCE_DATABASE.DW_SCHEMA.DIM_DATE T
    USING
    (
        SELECT DISTINCT
            TO_NUMBER(TO_CHAR(ORDER_DATE, 'YYYYMMDD')) AS DATE_KEY,
            ORDER_DATE                                  AS FULL_DATE,
            DAY(ORDER_DATE)                             AS DAY,
            MONTH(ORDER_DATE)                           AS MONTH,
            TO_CHAR(ORDER_DATE, 'MMMM')                 AS MONTH_NAME,
            QUARTER(ORDER_DATE)                         AS QUARTER,
            YEAR(ORDER_DATE)                            AS YEAR
        FROM ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES
        WHERE ORDER_DATE IS NOT NULL
    ) S
    ON T.DATE_KEY = S.DATE_KEY
    WHEN NOT MATCHED THEN
        INSERT (DATE_KEY, FULL_DATE, DAY, MONTH, MONTH_NAME, QUARTER, YEAR)
        VALUES (S.DATE_KEY, S.FULL_DATE, S.DAY, S.MONTH, S.MONTH_NAME, S.QUARTER, S.YEAR);
 
    -- ---------------------------------------------------------------
    -- STEP 3 : FACT_ORDERS  (insert only lines not already present)
    -- ---------------------------------------------------------------
    MERGE INTO ECOMMERCE_DATABASE.DW_SCHEMA.FACT_ORDERS T
    USING
    (
        SELECT
            S.SALES_LINE_ID,
            S.ORDER_ID,
            TO_NUMBER(TO_CHAR(S.ORDER_DATE, 'YYYYMMDD'))  AS DATE_KEY,
            C.CUSTOMER_KEY,
            P.PRODUCT_KEY,
            PM.PAYMENT_KEY,
            S.QUANTITY,
            S.UNIT_PRICE,
            S.UNIT_COST,
            S.QUANTITY * S.UNIT_PRICE                     AS SALES_AMOUNT,
            S.QUANTITY * (S.UNIT_PRICE - S.UNIT_COST)     AS PROFIT,
            S.FILE_NAME
        FROM ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES S
        JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_CUSTOMER C  ON C.CUSTOMER_ID = S.CUSTOMER_ID
        JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PRODUCT  P  ON P.PRODUCT_ID  = S.PRODUCT_ID
        JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PAYMENT  PM ON PM.PAYMENT_METHOD = S.PAYMENT_METHOD
                                                          AND PM.PAYMENT_STATUS = S.PAYMENT_STATUS
        WHERE S.ORDER_DATE IS NOT NULL
    ) X
    ON T.SALES_LINE_ID = X.SALES_LINE_ID
    WHEN NOT MATCHED THEN
        INSERT (SALES_LINE_ID, ORDER_ID, DATE_KEY, CUSTOMER_KEY, PRODUCT_KEY, PAYMENT_KEY,
                QUANTITY, UNIT_PRICE, UNIT_COST, SALES_AMOUNT, PROFIT, SOURCE_FILE)
        VALUES (X.SALES_LINE_ID, X.ORDER_ID, X.DATE_KEY, X.CUSTOMER_KEY, X.PRODUCT_KEY, X.PAYMENT_KEY,
                X.QUANTITY, X.UNIT_PRICE, X.UNIT_COST, X.SALES_AMOUNT, X.PROFIT, X.FILE_NAME);
 
    v_fact := SQLROWCOUNT;
 
    COMMIT;
 
    INSERT INTO ECOMMERCE_DATABASE.DW_SCHEMA.ETL_RUN_LOG (STATUS, ROWS_STAGED, ROWS_FACT, MESSAGE)
    VALUES ('SUCCESS', :v_staged, :v_fact, 'Load completed');
 
    RETURN 'SUCCESS: staged=' || v_staged || ', fact rows inserted=' || v_fact;
 
EXCEPTION
    WHEN OTHER THEN
        ROLLBACK;   -- stream is NOT consumed, so the same rows are retried next run
        INSERT INTO ECOMMERCE_DATABASE.DW_SCHEMA.ETL_RUN_LOG (STATUS, ROWS_STAGED, ROWS_FACT, MESSAGE)
        VALUES ('FAILED', 0, 0, :SQLERRM);
        RAISE;
END;
$$;






