    TYPE = JSON
    STRIP_OUTER_ARRAY = TRUE;      -- file = [ {order}, {order} ]  -> one row per orderECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_STAGEECOMMERCE_DATABASE.RAW_SCHEMA.ECOMMERCE_STAGE
 
