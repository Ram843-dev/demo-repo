/* =====================================================================
   PART 12 : REPORTING VIEW FOR POWER BI + VALIDATION QUERIES
   ===================================================================== */
 
-- 12.1 One flat view (optional; Power BI can also connect to the 5 tables directly)
CREATE OR REPLACE VIEW ECOMMERCE_DATABASE.DW_SCHEMA.VW_SALES_REPORT AS
SELECT
    F.SALES_LINE_ID, F.ORDER_ID,
    D.FULL_DATE, D.DAY, D.MONTH, D.MONTH_NAME, D.QUARTER, D.YEAR,
    C.CUSTOMER_ID, C.CUSTOMER_NAME, C.CITY, C.STATE,
    P.PRODUCT_ID, P.PRODUCT_NAME, P.CATEGORY,
    PM.PAYMENT_METHOD, PM.PAYMENT_STATUS,
    F.QUANTITY, F.UNIT_PRICE, F.UNIT_COST, F.SALES_AMOUNT, F.PROFIT
FROM ECOMMERCE_DATABASE.DW_SCHEMA.FACT_ORDERS F
JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_DATE     D  ON F.DATE_KEY     = D.DATE_KEY
JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_CUSTOMER C  ON F.CUSTOMER_KEY = C.CUSTOMER_KEY
JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PRODUCT  P  ON F.PRODUCT_KEY  = P.PRODUCT_KEY
JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PAYMENT  PM ON F.PAYMENT_KEY  = PM.PAYMENT_KEY;
 
-- 12.2 Daily / monthly / yearly sales from ONE fact table
SELECT FULL_DATE,  SUM(SALES_AMOUNT) AS DAILY_SALES,   SUM(PROFIT) AS PROFIT
FROM ECOMMERCE_DATABASE.DW_SCHEMA.VW_SALES_REPORT GROUP BY FULL_DATE ORDER BY FULL_DATE;
 
SELECT YEAR, MONTH, MONTH_NAME, SUM(SALES_AMOUNT) AS MONTHLY_SALES, SUM(PROFIT) AS PROFIT
FROM ECOMMERCE_DATABASE.DW_SCHEMA.VW_SALES_REPORT GROUP BY YEAR, MONTH, MONTH_NAME ORDER BY YEAR, MONTH;
 
SELECT YEAR, SUM(SALES_AMOUNT) AS YEARLY_SALES, SUM(PROFIT) AS PROFIT
FROM ECOMMERCE_DATABASE.DW_SCHEMA.VW_SALES_REPORT GROUP BY YEAR ORDER BY YEAR;
 
-- 12.3 Data quality checks (all should return 0 rows / 0)
-- duplicate fact lines
SELECT SALES_LINE_ID, COUNT(*) FROM ECOMMERCE_DATABASE.DW_SCHEMA.FACT_ORDERS GROUP BY SALES_LINE_ID HAVING COUNT(*) > 1;
-- fact rows with a missing dimension key
SELECT COUNT(*) AS BAD_ROWS FROM ECOMMERCE_DATABASE.DW_SCHEMA.FACT_ORDERS
WHERE DATE_KEY IS NULL OR CUSTOMER_KEY IS NULL OR PRODUCT_KEY IS NULL OR PAYMENT_KEY IS NULL;
-- fact keys with no matching date row
SELECT COUNT(*) AS ORPHAN_DATES FROM ECOMMERCE_DATABASE.DW_SCHEMA.FACT_ORDERS F
LEFT JOIN ECOMMERCE_DATABASE.DW_SCHEMA.DIM_DATE D ON F.DATE_KEY = D.DATE_KEY WHERE D.DATE_KEY IS NULL;
-- raw items vs fact lines (numbers should match once the stream is empty)
SELECT
  (SELECT COUNT(*) FROM ECOMMERCE_DATABASE.RAW_SCHEMA.RAW_ECOMMERCE_ORDERS R,
        LATERAL FLATTEN(INPUT => R.VARIANT_COL:items) F) AS RAW_ITEM_LINES,
  (SELECT COUNT(*) FROM ECOMMERCE_DATABASE.DW_SCHEMA.FACT_ORDERS)                        AS FACT_LINES;
 
-- 12.4 Monitoring
SELECT * FROM ECOMMERCE_DATABASE.DW_SCHEMA.ETL_RUN_LOG ORDER BY RUN_TS DESC LIMIT 20;
SELECT * FROM TABLE(ECOMMERCE_DATABASE.INFORMATION_SCHEMA.COPY_HISTORY(
        TABLE_NAME => 'RAW_ECOMMERCE_ORDERS',
        START_TIME => DATEADD(DAY, -7, CURRENT_TIMESTAMP())))
ORDER BY LAST_LOAD_TIME DESC;
 


