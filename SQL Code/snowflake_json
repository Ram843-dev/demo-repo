/* =====================================================================
   PART 4 : DIMENSION TABLES, FACT TABLE, STAGING TABLE, LOG TABLE
   ===================================================================== */
 
-- 4.1 Customer dimension
CREATE TABLE IF NOT EXISTS ECOMMERCE_DATABASE.DW_SCHEMA.DIM_CUSTOMER
(
    CUSTOMER_KEY  NUMBER AUTOINCREMENT START 1 INCREMENT 1,
    CUSTOMER_ID   STRING,
    CUSTOMER_NAME STRING,
    CITY          STRING,
    STATE         STRING,
    CREATED_TS    TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    UPDATED_TS    TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);

-- 4.2 Product dimension
CREATE TABLE IF NOT EXISTS ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PRODUCT
(
    PRODUCT_KEY   NUMBER AUTOINCREMENT START 1 INCREMENT 1,
    PRODUCT_ID    STRING,
    PRODUCT_NAME  STRING,
    CATEGORY      STRING,
    CREATED_TS    TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    UPDATED_TS    TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);


-- 4.3 Payment dimension
CREATE TABLE IF NOT EXISTS ECOMMERCE_DATABASE.DW_SCHEMA.DIM_PAYMENT
(
    PAYMENT_KEY    NUMBER AUTOINCREMENT START 1 INCREMENT 1,
    PAYMENT_METHOD STRING,
    PAYMENT_STATUS STRING
);

-- 4.4 Date dimension
CREATE TABLE IF NOT EXISTS ECOMMERCE_DATABASE.DW_SCHEMA.DIM_DATE
(
    DATE_KEY   NUMBER,            -- format YYYYMMDD, e.g. 20261001
    FULL_DATE  DATE,
    DAY        NUMBER,
    MONTH      NUMBER,
    MONTH_NAME STRING,
    QUARTER    NUMBER,
    YEAR       NUMBER
);

-- 4.5 Fact table (one row per order line item)
CREATE TABLE IF NOT EXISTS ECOMMERCE_DATABASE.DW_SCHEMA.FACT_ORDERS
(
    SALES_LINE_ID STRING,          -- ORDER_ID || '-' || ITEM_INDEX  (unique)
    ORDER_ID      STRING,
    DATE_KEY      NUMBER,
    CUSTOMER_KEY  NUMBER,
    PRODUCT_KEY   NUMBER,
    PAYMENT_KEY   NUMBER,
    QUANTITY      NUMBER,
    UNIT_PRICE    NUMBER(10,2),
    UNIT_COST     NUMBER(10,2),
    SALES_AMOUNT  NUMBER(12,2),
    PROFIT        NUMBER(12,2),
    SOURCE_FILE   STRING,
    LOAD_TS       TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);

-- 4.6 Staging table (flattened new rows for each run; cleared by the procedure)
CREATE TRANSIENT TABLE IF NOT EXISTS ECOMMERCE_DATABASE.DW_SCHEMA.STG_ORDER_LINES
(
    SALES_LINE_ID  STRING,
    ORDER_ID       STRING,
    ORDER_DATE     DATE,
    CUSTOMER_ID    STRING,
    CUSTOMER_NAME  STRING,
    CITY           STRING,
    STATE          STRING,
    PAYMENT_METHOD STRING,
    PAYMENT_STATUS STRING,
    ITEM_INDEX     NUMBER,
    PRODUCT_ID     STRING,
    PRODUCT_NAME   STRING,
    CATEGORY       STRING,
    QUANTITY       NUMBER,
    UNIT_PRICE     NUMBER(10,2),
    UNIT_COST      NUMBER(10,2),
    FILE_NAME      STRING,
    LOAD_TS        TIMESTAMP_NTZ
);

-- 4.7 Run log (one row per procedure run)
CREATE TABLE IF NOT EXISTS ECOMMERCE_DATABASE.DW_SCHEMA.ETL_RUN_LOG
(
    RUN_TS       TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    STATUS       STRING,
    ROWS_STAGED  NUMBER,
    ROWS_FACT    NUMBER,
    MESSAGE      STRING
);


/* =====================================================================
   PART 5 : FILL DIM_DATE ONCE  (2020-01-01 to 2035-12-31)
   Safe to re-run: only inserts missing dates.
   ===================================================================== */
MERGE INTO ECOMMERCE_DATABASE.DW_SCHEMA.DIM_DATE T
USING
(
    SELECT
        TO_NUMBER(TO_CHAR(D, 'YYYYMMDD')) AS DATE_KEY,
        D                                 AS FULL_DATE,
        DAY(D)                            AS DAY,
        MONTH(D)                          AS MONTH,
        TO_CHAR(D, 'MMMM')                AS MONTH_NAME,
        QUARTER(D)                        AS QUARTER,
        YEAR(D)                           AS YEAR
    FROM (
        SELECT DATEADD(DAY, SEQ4(), '2020-01-01'::DATE) AS D
        FROM TABLE(GENERATOR(ROWCOUNT => 5844))
    )
) S
ON T.DATE_KEY = S.DATE_KEY
WHEN NOT MATCHED THEN
    INSERT (DATE_KEY, FULL_DATE, DAY, MONTH, MONTH_NAME, QUARTER, YEAR)
    VALUES (S.DATE_KEY, S.FULL_DATE, S.DAY, S.MONTH, S.MONTH_NAME, S.QUARTER, S.YEAR);
 
SELECT COUNT(*) AS DATE_ROWS, MIN(FULL_DATE), MAX(FULL_DATE) FROM ECOMMERCE_DATABASE.DW_SCHEMA.DIM_DATE;


